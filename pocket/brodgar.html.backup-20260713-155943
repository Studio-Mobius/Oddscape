<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
>

<title>OddPocket | Ring of Brodgar</title>

<meta
    name="description"
    content="Explore the Ring of Brodgar terrain in interactive 3D and augmented reality with OddPocket by Studio Oddscape."
>

<style>
:root{
    --gold:#d9bc82;
    --text:#dce3e8;
    --muted:#9aa5ac;
    --line:rgba(217,188,130,.20);
    --blue:#8fcaff;
    --top:#203746;
    --middle:#10232f;
    --bottom:#06141d;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    min-height:100%;
    background:#06141d;
}

body{
    min-height:100vh;
    color:var(--text);
    background:
        radial-gradient(
            circle at top,
            var(--top) 0%,
            var(--middle) 46%,
            var(--bottom) 100%
        );
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
}

.page{
    width:min(760px,100%);
    min-height:100vh;
    margin:0 auto;
    padding:
        max(30px,env(safe-area-inset-top))
        22px
        max(38px,env(safe-area-inset-bottom));
    display:flex;
    flex-direction:column;
}

header{
    text-align:center;
    padding:10px 0 26px;
}

.brand{
    color:var(--gold);
    font-size:clamp(38px,9vw,62px);
    font-weight:800;
    line-height:.95;
    letter-spacing:-2px;
}

.product{
    margin-top:13px;
    color:var(--blue);
    font-size:11px;
    font-weight:700;
    letter-spacing:4px;
    text-transform:uppercase;
}

.hud{
    position:relative;
    width:min(460px,82%);
    height:24px;
    margin:21px auto 0;
}

.hud::before,
.hud::after{
    content:"";
    position:absolute;
    top:50%;
    width:calc(50% - 23px);
    height:1px;
}

.hud::before{
    left:0;
    background:linear-gradient(
        90deg,
        transparent,
        rgba(217,188,130,.58)
    );
}

.hud::after{
    right:0;
    background:linear-gradient(
        90deg,
        rgba(217,188,130,.58),
        transparent
    );
}

.hud-mark{
    position:absolute;
    left:50%;
    top:50%;
    width:22px;
    height:22px;
    transform:translate(-50%,-50%);
}

.hud-mark svg{
    display:block;
    width:100%;
    height:100%;
    fill:none;
    stroke:var(--gold);
    stroke-width:1.4;
    stroke-linecap:round;
}

.intro{
    text-align:center;
    margin-bottom:22px;
}

.kicker{
    color:var(--muted);
    font-size:11px;
    font-weight:700;
    letter-spacing:3px;
    text-transform:uppercase;
}

h1{
    margin-top:8px;
    color:var(--gold);
    font-size:clamp(30px,7vw,48px);
    line-height:1.08;
}

.intro-copy{
    max-width:560px;
    margin:14px auto 0;
    color:#cbd5db;
    font-size:16px;
    line-height:1.65;
}

.viewer-shell{
    position:relative;
    overflow:hidden;
    border:1px solid var(--line);
    border-radius:18px;
    background:#05080d;
    box-shadow:
        0 28px 80px rgba(0,0,0,.46),
        inset 0 1px 0 rgba(255,255,255,.04);
}

.viewer-toolbar{
    min-height:46px;
    padding:0 16px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    border-bottom:1px solid var(--line);
    background:#080d15;
    color:var(--gold);
    font-size:10px;
    font-weight:700;
    letter-spacing:2px;
    text-transform:uppercase;
}

.live{
    display:inline-block;
    width:7px;
    height:7px;
    margin-right:8px;
    border-radius:50%;
    background:#58d9ff;
    box-shadow:0 0 10px #58d9ff;
}

.place{
    color:var(--muted);
    text-align:right;
}

model-viewer{
    display:block;
    width:100%;
    height:min(58vh,520px);
    min-height:390px;
    background:
        radial-gradient(
            circle at center,
            #101826 0%,
            #05080d 74%
        );
    --poster-color:transparent;
}

.viewer-caption{
    padding:12px 16px;
    border-top:1px solid var(--line);
    background:#080d15;
    color:var(--muted);
    text-align:center;
    font-size:10px;
    letter-spacing:1.5px;
    line-height:1.5;
    text-transform:uppercase;
}

.ar-button{
    position:absolute;
    z-index:5;
    left:50%;
    bottom:52px;
    transform:translateX(-50%);
    min-width:210px;
    padding:14px 22px;
    border:1px solid rgba(217,188,130,.62);
    border-radius:999px;
    color:#07121b;
    background:var(--gold);
    box-shadow:
        0 12px 34px rgba(0,0,0,.38),
        0 0 22px rgba(217,188,130,.18);
    font:inherit;
    font-size:12px;
    font-weight:800;
    letter-spacing:2px;
    text-transform:uppercase;
    cursor:pointer;
    -webkit-tap-highlight-color:transparent;
}

.ar-button:active{
    transform:translateX(-50%) scale(.97);
}

.guidance{
    margin-top:22px;
    padding:20px;
    border:1px solid var(--line);
    border-radius:14px;
    background:rgba(4,12,20,.34);
}

.guidance h2{
    color:var(--gold);
    font-size:19px;
}

.guidance p{
    margin-top:9px;
    color:#c4cfd6;
    font-size:14px;
    line-height:1.6;
}

.fallback-links{
    margin-top:16px;
    display:flex;
    justify-content:center;
    gap:10px;
    flex-wrap:wrap;
}

.small-link{
    display:inline-block;
    padding:11px 15px;
    border:1px solid rgba(217,188,130,.32);
    border-radius:999px;
    color:var(--gold);
    text-decoration:none;
    font-size:10px;
    font-weight:700;
    letter-spacing:1.5px;
    text-transform:uppercase;
}

.small-link:hover{
    background:rgba(217,188,130,.07);
}

.explore{
    margin-top:auto;
    padding-top:34px;
    text-align:center;
}

.explore p{
    color:var(--muted);
    font-size:14px;
}

.home-link{
    display:inline-block;
    margin-top:15px;
    padding:14px 25px;
    border:1px solid rgba(217,188,130,.48);
    color:var(--gold);
    text-decoration:none;
    font-size:11px;
    font-weight:700;
    letter-spacing:2.5px;
    text-transform:uppercase;
}

.home-link:hover{
    background:rgba(217,188,130,.08);
}

.status{
    min-height:22px;
    margin-top:13px;
    color:var(--blue);
    text-align:center;
    font-size:12px;
    line-height:1.5;
}

@media(max-width:520px){
    .page{
        padding-left:14px;
        padding-right:14px;
    }

    header{
        padding-bottom:21px;
    }

    .intro-copy{
        font-size:15px;
    }

    model-viewer{
        min-height:420px;
        height:56vh;
    }

    .viewer-toolbar{
        padding:0 12px;
        font-size:9px;
        letter-spacing:1.4px;
    }

    .ar-button{
        bottom:55px;
        min-width:190px;
    }
}

@media(prefers-reduced-motion:reduce){
    *{
        scroll-behavior:auto !important;
    }
}
</style>

<script
    type="module"
    src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js">
</script>
</head>

<body>

<main class="page">

    <header>
        <div class="brand">Oddscape</div>
        <div class="product">OddPocket</div>

        <div class="hud" aria-hidden="true">
            <span class="hud-mark">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="7"></circle>
                    <path d="M12 8v8"></path>
                    <path d="M8 12h8"></path>
                </svg>
            </span>
        </div>
    </header>

    <section
        class="viewer-shell"
        aria-label="Interactive Ring of Brodgar terrain"
    >
        <div class="viewer-toolbar">
            <div>
                <span class="live"></span>
                OddView Live
            </div>

            <div class="place">
                Ring of Brodgar
            </div>
        </div>

        <model-viewer
            id="brodgarViewer"
            src="../models/terrain.glb"
            ios-src="../models/terrain.usdz"
            alt="Interactive terrain model of the Ring of Brodgar"
            camera-controls
            auto-rotate
            ar
            ar-modes="webxr scene-viewer quick-look"
            shadow-intensity="1"
            exposure="1"
            interaction-prompt="auto"
            touch-action="pan-y"
        >
            <button
                id="arButton"
                class="ar-button"
                slot="ar-button"
                type="button"
            >
                View in AR
            </button>
        </model-viewer>

        <div class="viewer-caption">
            Drag to rotate · Pinch to zoom · Tap View in AR
        </div>
    </section>

    <section class="intro">
        <p class="kicker">Take the landscape with you</p>

        <h1>Ring of Brodgar</h1>

        <p class="intro-copy">
            Explore this Neolithic landscape in interactive 3D.
            On a compatible phone, place the terrain directly into
            your surroundings using augmented reality.
        </p>
    </section>

    <p id="status" class="status" aria-live="polite"></p>

    <section class="guidance">
        <h2>AR unavailable?</h2>

        <p>
            You can still rotate, zoom and explore the complete terrain
            model above. AR availability depends on the phone, browser
            and operating system.
        </p>

        <div class="fallback-links">
            <a
                class="small-link"
                href="../models/terrain.usdz"
                rel="ar"
            >
                Open Apple AR file
            </a>

            <a
                class="small-link"
                href="../models/terrain.glb"
                download
            >
                Download 3D model
            </a>
        </div>
    </section>

    <section class="explore">
        <p>Curious what else is hidden in the landscape?</p>

        <a class="home-link" href="../index.html">
            Explore Oddscape
        </a>
    </section>

</main>

<script>
(function(){
    const viewer = document.getElementById("brodgarViewer");
    const arButton = document.getElementById("arButton");
    const status = document.getElementById("status");

    function buzz(){
        if("vibrate" in navigator){
            navigator.vibrate([35,45,35]);
        }
    }

    arButton.addEventListener("click",function(){
        buzz();
        status.textContent =
            "Preparing the Ring of Brodgar AR experience...";
    });

    viewer.addEventListener("ar-status",function(event){
        const state = event.detail.status;

        if(state === "session-started"){
            status.textContent =
                "AR opened. Move your phone slowly to find a surface.";
        }

        if(state === "failed"){
            status.textContent =
                "AR could not open on this device. Interactive 3D remains available above.";
        }

        if(state === "not-presenting"){
            status.textContent =
                "You can continue exploring the terrain in interactive 3D.";
        }
    });

    viewer.addEventListener("load",function(){
        status.textContent =
            "Terrain ready. Drag to explore or tap View in AR.";
    });

    viewer.addEventListener("error",function(){
        status.textContent =
            "The terrain model could not be loaded. Please try again.";
    });
})();
</script>

</body>
</html>
